<?xml version="1.0"?>
<package format="3">
  <name>mujoco_bridge</name>
  <version>0.0.1</version>
  <description>Minimal headless ROS 2 to MuJoCo joint-control learning examples.</description>
  <maintainer email="cotton@example.com">cotton</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>ament_index_cpp</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>hip_topic_demo</exec_depend>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
